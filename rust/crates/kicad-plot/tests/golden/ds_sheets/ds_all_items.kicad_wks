(kicad_wks (version 20231118) (generator "pl_editor") (generator_version "8.0")
  (setup (textsize 1.7 1.6) (linewidth 0.2) (textlinewidth 0.12)
    (left_margin 12) (right_margin 8.5) (top_margin 7) (bottom_margin 11.25))
  (rect (name "frame") (start 0 0 ltcorner) (end 0 0) (repeat 3) (incrx 1.5) (incry 1.5) (linewidth 0.3) (comment "frame"))
  (rect (name "p1") (start 120 40) (end 2 2) (option page1only))
  (rect (name "pn") (start 60 20) (end 2 2) (option notonpage1))
  (line (name "lt") (start 25 3 ltcorner) (end 25 0 ltcorner) (repeat 40) (incrx 25))
  (line (name "lb") (start 25 3 lbcorner) (end 25 0 lbcorner) (repeat 40) (incrx 25) (linewidth 0.05))
  (line (name "rt") (start 0 30 rtcorner) (end 3 30 rtcorner) (repeat 20) (incry 30))
  (line (name "rb") (start 3 30 rbcorner) (end 0 30 rbcorner) (repeat 20) (incry 30))
  (line (name "diag") (start 5 5 ltcorner) (end 30 25 rbcorner))
  (tbtext "1" (name "num") (pos 12.5 1.5 ltcorner) (font (size 1.2 1.2)) (repeat 40) (incrx 25))
  (tbtext "A" (name "let") (pos 1.5 15 ltcorner) (font (size 1.2 1.2)) (justify center) (repeat 30) (incry 30))
  (tbtext "z" (name "low") (pos 1.5 15 rtcorner) (justify center) (repeat 30) (incry 30) (incrlabel 3))
  (tbtext "R9-" (name "mix") (pos 30 1.5 lbcorner) (repeat 12) (incrx 25) (incrlabel -1))
  (tbtext "007" (name "pad") (pos 40 50 ltcorner) (repeat 4) (incry 5) (incrlabel 2))
  (tbtext "Title: ${TITLE}" (pos 118 30) (font (size 2.5 2.5) bold italic) (maxlen 60))
  (tbtext "Company ${COMPANY} long long long long long long long text" (pos 118 25) (maxlen 40) (maxheight 1))
  (tbtext "Line1\\nLine2 ${REVISION}\\nLine3\\\\n" (pos 118 20) (justify right bottom) (rotate 0))
  (tbtext "Rot ${#}/${##} ${PAPER} ${LAYER}" (pos 60 60 ltcorner) (rotate 90) (justify left top))
  (tbtext "Rot45 ${SHEETNAME} ${SHEETPATH}" (pos 80 60 ltcorner) (rotate 45) (justify center))
  (tbtext "File ${FILENAME} path ${FILEPATH}" (pos 118 15) (font (linewidth 0.3) (size 1.1 0.9)))
  (tbtext "C1 ${COMMENT1} C2 ${COMMENT2} C9 ${COMMENT9} D ${ISSUE_DATE}" (pos 118 10) (font (color 10 200 30 0.5)))
  (tbtext "Var ${VARIANT} ${VARIANT_DESC} ${UNKNOWN} ${KICAD_VERSION} ~{over} \\${esc}" (pos 118 5) (font bold) (justify right))
  (tbtext "TopBottom" (pos 100 80 ltcorner) (justify top) (font italic))
  (tbtext "" (pos 100 90 ltcorner))
  (tbtext "Multi\\nline\\nrepeat" (pos 140 80 ltcorner) (repeat 3) (incrx 20) (justify center))
  (tbtext "P1 only" (pos 160 40) (option page1only))
  (polygon (name "logo") (pos 150 50 ltcorner) (rotate 20) (linewidth 0.05) (repeat 4) (incrx 70)
    (pts (xy 0 0) (xy 10.5 0) (xy 10.5 4.2) (xy 0 4.2))
    (pts (xy 2 1) (xy 8.3 1.7) (xy 5.1 3.9)))
  (polygon (name "big") (pos 30 40 rbcorner) (repeat 3) (incry -40)
    (pts (xy -5 -5) (xy 5 -5) (xy 0 6)))
  (line (name "off") (start 10 10 ltcorner) (end 20 20 ltcorner) (repeat 50) (incrx 40) (incry 40))
)
