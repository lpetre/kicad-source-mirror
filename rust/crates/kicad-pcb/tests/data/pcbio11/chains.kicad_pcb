(kicad_pcb
	(version 20250926)
	(generator "pcbnew")
	(generator_version "9.99")
	(general
		(thickness 1.6)
		(legacy_teardrops no)
	)
	(paper "A4")
	(layers
		(0 "F.Cu" signal)
		(2 "B.Cu" signal)
		(25 "Edge.Cuts" user)
	)
	(setup
		(pad_to_mask_clearance 0)
	)
	(variants
		(variant (name "Alpha") (description "First \"variant\""))
		(variant (name "beta"))
		(variant (name "ALPHA") (description "case-insensitive duplicate"))
		(variant (name "Default") (description "the default variant is never added"))
		(variant (description "no name"))
		(variant (name "Gamma") (description "Gamma description"))
	)
	(net 0 "")
	(net 1 "CLK")
	(net 2 "DATA")
	(net 3 "bus_a")
	(net 4 "BUS_B")
	(net 5 "N10")
	(net 6 "N2")
	(net 7 "/sheet/Q~{A}")
	(net 8 "lonely")
	(net_chains
		(net_chain (name "CH10") (members (net "N10") (net "does-not-exist")))
		(net_chain (name "CH2") (members (net 6)))
		(net_chain (name "bus") (members (member (net "bus_a"))))
		(net_chain (name "BUS") (members (net "BUS_B")))
		(net_chain (name 42) (members (net "CLK") (bogus "x") (net "DATA")) (unknown "skipped"))
		(something (else "ignored"))
		(net_chain (name "1K5") (members (net "/sheet/Q~{A}")))
		(net_chain (name "1.5K") (members (net "lonely")))
	)
	(embedded_fonts no)
)
