(kicad_pcb (version 20210108) (generator pcbnew)
  (general (thickness 1.6))
  (paper "A4")
  (layers (0 "F.Cu" signal) (1 "In1.Cu" signal) (2 "In2.Cu" signal) (31 "B.Cu" signal) (32 "B.Adhes" user) (33 "F.Adhes" user) (34 "B.Paste" user) (35 "F.Paste" user) (36 "B.SilkS" user) (37 "F.SilkS" user) (38 "B.Mask" user) (39 "F.Mask" user) (40 "Dwgs.User" user) (44 "Edge.Cuts" user))
  (setup
    (stackup
      (layer "F.SilkS" (type "Top Silk Screen") (color "#E0E0E0"))
      (layer "F.Paste" (type "Top Solder Paste"))
      (layer "F.Mask" (type "Top Solder Mask") (color "#10A040") (thickness 0.012) (material "Dry") (epsilon_r 3.5) (loss_tangent 0.01))
      (layer "F.Cu" (type "copper") (thickness 0.035) (color "#FF0000"))
      (layer "dielectric 1" (type "prepreg") (thickness 0.2 locked) (material "FR4") (epsilon_r 4.2) (loss_tangent 0.02) addsublayer (thickness 0.1) (material "PP") (epsilon_r 3.9) (loss_tangent 0.015) (unknown_param 1 (x 2)))
      (layer "In1.Cu" (type "copper") (thickness 0.0175))
      (layer "dielectric 2" (type "core") (thickness 0.8) (material "FR4") (epsilon_r 4.5) (loss_tangent 0.02))
      (layer "In2.Cu" (type "copper") (thickness 0.0175))
      (layer "dielectric 3" (type "prepreg") (thickness 0.2) (material "FR4") (epsilon_r 4.5) (loss_tangent 0.02))
      (layer "B.Cu" (type "copper") (thickness 0.035))
      (layer "B.Mask" (type "Bottom Solder Mask") (color "Green") (thickness 0.01))
      (layer "B.Paste" (type "Bottom Solder Paste"))
      (layer "B.SilkS" (type "Bottom Silk Screen") (color "White"))
      (copper_finish "ENIG")
      (dielectric_constraints yes)
      (edge_connector bevelled)
      (castellated_pads yes)
      (edge_plating yes)
      (something_new (a b))
    )
    (pad_to_mask_clearance 0)
    (defaults
      (edge_clearance 0.3)
      (edge_cuts_line_width 0.05)
      (courtyard_line_width 0.06)
      (copper_line_width 0.21)
      (copper_text_dims (size 1.6 1.4) (thickness 0.31) keep_upright)
      (silk_line_width 0.13)
      (silk_text_dims (size 1.1 0.9) (thickness 0.16) italic)
      (fab_layers_line_width 0.11)
      (fab_layers_text_dims (size 1.2 1.3) (thickness 0.17))
      (other_layers_line_width 0.12)
      (other_layers_text_dims (size 0.8 0.7) (thickness 0.14) italic keep_upright)
      (dimension_units 2)
      (dimension_precision 3))
    (pcbplotparams
      (layerselection 0x010fc_ffffffff)
      (disableapertmacros true)
      (usegerberextensions false)
      (svguseinch false)
      (svgprecision 9)
      (excludeedgelayer true)
      (outputformat 9)
      (drillshape 7)
      (scaleselection -1)
      (outputdirectory 123))
  ))
