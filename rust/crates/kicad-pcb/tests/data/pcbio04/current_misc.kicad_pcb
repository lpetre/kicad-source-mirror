(kicad_pcb (version 20261031) (generator "pcbnew") (generator_version "10.99")
  (general (thickness 1.6) (legacy_teardrops no))
  (paper "A4")
  (layers (0 "F.Cu" signal) (4 "In1.Cu" signal) (6 "In2.Cu" signal) (2 "B.Cu" signal) (9 "F.Adhes" user "F.Adhesive") (11 "B.Adhes" user "B.Adhesive") (13 "F.Paste" user) (15 "B.Paste" user) (5 "F.SilkS" user "F.Silkscreen") (7 "B.SilkS" user "B.Silkscreen") (1 "F.Mask" user) (3 "B.Mask" user) (17 "Dwgs.User" user "User.Drawings") (25 "Edge.Cuts" user) (27 "Margin" user) (31 "F.CrtYd" user "F.Courtyard") (29 "B.CrtYd" user "B.Courtyard") (35 "F.Fab" user) (33 "B.Fab" user))
  (setup
    (stackup
      (layer "F.SilkS" (type "Top Silk Screen") (color "#E0E0E0E0"))
      (layer "F.Mask" (type "Top Solder Mask") (thickness 0.01))
      (layer "F.Cu" (type "copper") (thickness 0.035))
      (layer "dielectric 1" (type "prepreg") (thickness 0.1 locked) (material "FR408-HR") (epsilon_r 3.68) (loss_tangent 0.0092) (spec_frequency 1000000000) (dielectric_model djordjevic_sarkar))
      (layer "In1.Cu" (type "copper") (thickness 0.0175))
      (layer "dielectric 2" (type "core") (thickness 1.2) (material "FR4") (epsilon_r 4.5) (loss_tangent 0.02) (spec_frequency 2.5e9) (dielectric_model constant) addsublayer (thickness 0.05) (material "Not specified"))
      (layer "In2.Cu" (type "copper") (thickness 0.0175))
      (layer "dielectric 3" (type "prepreg") (thickness 0.1) (material "FR4") (epsilon_r 4.5) (loss_tangent 0.02))
      (layer "B.Cu" (type "copper") (thickness 0.035))
      (layer "B.Mask" (type "Bottom Solder Mask") (thickness 0.01))
      (copper_finish "None")
      (dielectric_constraints no)
      (edge_connector yes))
    (pad_to_mask_clearance 0.02)
    (pad_to_paste_clearance_ratio 0.00005)
    (allow_soldermask_bridges_in_footprints yes)
    (tenting (front no) (back yes))
    (covering (front yes) (back none))
    (plugging (front none) (back yes))
    (capping yes)
    (filling yes)
    (grid_origin 1.5 2.5)
    (drill_symbol_profile (name "Fab \"A\"") (group_by slot size bogus protection) (default_marks letters) (size 2) (width 0.2) (freeze_assignments no) (future (x y))
      (assignment (key "v1|d300000") (mark shape 7) (descr "Via"))
      (assignment (key "v1|d800000|p0") (mark letter "Q") (other 1))
      (assignment (key "v1|d1000000") (mark size_text))
      (assignment (mark letter "Z")))
    (pcbplotparams
      (layerselection 0x00000000_00000000_55555555_5755f5ff)
      (plot_on_all_layers_selection 0x00000000_00000000_00000000_02000000)
      (disableapertmacros no)
      (usegerberextensions yes)
      (usegerberattributes no)
      (usegerberadvancedattributes no)
      (creategerberjobfile no)
      (gerberprecision 5)
      (dashed_line_dash_ratio 10.5)
      (dashed_line_gap_ratio 2.25)
      (svgprecision 1)
      (pngdpi 10)
      (pngantialias no)
      (plotframeref yes)
      (mode 1)
      (useauxorigin no)
      (pdf_front_fp_property_popups no)
      (pdf_back_fp_property_popups no)
      (pdf_metadata no)
      (pdf_single_document yes)
      (dxfpolygonmode no)
      (dxfimperialunits no)
      (dxfusepcbnewfont no)
      (psnegative no)
      (psa4output no)
      (plot_black_and_white no)
      (sketchpadsonfab yes)
      (plotpadnumbers yes)
      (hidednponfab yes)
      (sketchdnponfab no)
      (crossoutdnponfab no)
      (subtractmaskfromsilk yes)
      (outputformat 5)
      (mirror no)
      (drillshape 2)
      (scaleselection 2)
      (unknownparam (a (b c)))
      (outputdirectory "out dir/x"))
  )
  (embedded_fonts no))
