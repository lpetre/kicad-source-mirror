(kicad_pcb
	(version 20230620)
	(generator pcbnew)
	(general
    (thickness 1.6)
  )
	(paper "A")
	(layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (32 "B.Adhes" user "B.Adhesive")
    (33 "F.Adhes" user "F.Adhesive")
    (34 "B.Paste" user)
