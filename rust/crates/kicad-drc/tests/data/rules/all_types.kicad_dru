(version 1)
(rule a
 (constraint creepage (min 1mm))
 (constraint hole_clearance (min 1mm))
 (constraint edge_clearance (min 1mm))
 (constraint hole_to_hole (min 1mm))
 (constraint courtyard_clearance (min 1mm))
 (constraint silk_clearance (min 1mm))
 (constraint text_height (min 1mm))
 (constraint text_thickness (min 1mm))
 (constraint track_segment_length (min 1mm))
 (constraint connection_width (min 1mm))
 (constraint via_diameter (min 1mm))
 (constraint thermal_relief_gap (min 1mm))
 (constraint thermal_spoke_width (min 1mm))
 (constraint solder_mask_sliver (min 1mm))
 (constraint solder_paste_abs_margin (opt 1mm))
 (constraint diff_pair_gap (min 1mm) (opt 2mm) (max 3mm))
 (constraint diff_pair_uncoupled (max 1mm))
 (constraint physical_clearance (min 1mm))
 (constraint physical_hole_clearance (min 1mm))
)
