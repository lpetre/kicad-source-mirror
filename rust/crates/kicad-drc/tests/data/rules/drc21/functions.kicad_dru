(version 1)
(rule r0
  (condition "A.unknownFunction()")
  (constraint clearance (min 0.1mm)))
(rule r1
  (condition "A.existsOnLayer('F.Cu') && B.isPlated()")
  (constraint clearance (min 0.1mm)))
(rule r2
  (condition "A.insideCourtyard('U1')")
  (constraint clearance (min 0.1mm)))
(rule r3
  (condition "A.IntersectsArea('zone')")
  (constraint clearance (min 0.1mm)))
(rule r4
  (condition "A.enclosedByArea('z') || A.memberOfGroup('g')")
  (constraint clearance (min 0.1mm)))
(rule r5
  (condition "B.Parent.unknownFunction()")
  (constraint clearance (min 0.1mm)))
(rule r6
  (condition "L.isPlated()")
  (constraint clearance (min 0.1mm)))
(rule r7
  (condition "A.intersectsFrontCourtyard(B.Parent)")
  (constraint clearance (min 0.1mm)))
(rule r8
  (condition "A.hasNetclass(B.NetClass)")
  (constraint clearance (min 0.1mm)))
