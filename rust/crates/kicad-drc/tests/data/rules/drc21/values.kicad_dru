(version 1)
(rule v0
  (condition "A.Type == 'Track'")
  (constraint track_width (min A.Width)))
(rule v1
  (constraint track_width (min 0.1mm + 2mil) (max 1mm * 2)))
(rule v2
  (constraint assertion "A.Width > 0.2mm && A.Bogus == 1"))
(rule v3
  (condition "A.Type == 'Via' && A.Via_Type == 'Micro'")
  (constraint via_diameter (min 0.2mm)))
